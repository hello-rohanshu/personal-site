---
// ============================================================
// DUMMY DATA (temporary — UI iteration only)
// Set USE_DUMMY = false to consume real (Notion-fed) props.
// ============================================================
const USE_DUMMY = true;

type StatusValue = "working-on" | "paused" | "planned";
type Level = "high" | "medium" | "low";

interface Project {
  slug: string;
  data: {
    title: string;
    description?: string;
    status: StatusValue | StatusValue[];
    eta?: string;
    link?: string;
    role?: string;
    order?: number;
    ctaLabel?: string;
    version?: string;
    effort?: Level;
    leverage?: Level;
  };
}

const DUMMY_PROJECTS: Project[] = [
  {
    slug: "dummy-ostium",
    data: {
      title: "Ostium",
      description:
        "A minimal personal knowledge manager that lives in your menu bar.",
      status: "paused",
      link: "https://example.com",
      version: "v1.4.2",
      effort: "high",
      leverage: "high",
      order: 1,
    },
  },
  {
    slug: "dummy-quiet-hours",
    data: {
      title: "Quiet Hours",
      description:
        "A focus timer that respects your calendar and mutes itself during calls.",
      status: "paused",
      eta: "2026-11-15",
      version: "v0.3.0",
      effort: "low",
      leverage: "medium",
      order: 2,
    },
  },
  {
    slug: "dummy-field-notes",
    data: {
      title: "Field Notes",
      description: "A pocket notebook for capture, sync, and slow review.",
      status: "working-on",
      effort: "medium",
      leverage: "high",
      order: 3,
    },
  },
  {
    slug: "dummy-tide",
    data: {
      title: "Tide",
      description: "Sleep-aware reading companion.",
      status: "paused",
      effort: "low",
      leverage: "low",
      order: 4,
    },
  },
];

const propProjects = (Astro.props as { projects?: Project[] }).projects;
const projects: Project[] = USE_DUMMY ? DUMMY_PROJECTS : (propProjects ?? []);

// -------- status --------
const STATUS_ORDER: Record<string, number> = {
  "working-on": 0,
  paused: 1,
  planned: 2,
};
const STATUS_LABEL: Record<string, string> = {
  "working-on": "Working on",
  paused: "Paused",
  planned: "Planned",
};

const normalizeStatus = (s: string | string[]) => (Array.isArray(s) ? s : [s]);

// A paused project that has a date but no usable surface reads as "planned".
const effectiveStatuses = (p: Project): string[] => {
  const raw = normalizeStatus(p.data.status);
  if (raw.includes("paused") && !p.data.link && p.data.eta) {
    return raw.map((s) => (s === "paused" ? "planned" : s));
  }
  return raw;
};
const primaryStatus = (s: string | string[]) => {
  const list = normalizeStatus(s);
  return list.reduce(
    (best, cur) => (STATUS_ORDER[cur] < STATUS_ORDER[best] ? cur : best),
    list[0],
  );
};

// -------- effort / leverage --------
const levelLabel = (level: Level, kind: "effort" | "leverage") =>
  `${level.charAt(0).toUpperCase()}${level.slice(1)} ${kind}`;

// -------- humane eta --------
const formatEta = (raw: string): string => {
  const d = new Date(raw);
  if (isNaN(d.getTime())) return raw;
  const now = new Date();
  const withinYear = d.getTime() - now.getTime() < 1000 * 60 * 60 * 24 * 365;
  const sameYear = d.getFullYear() === now.getFullYear();
  if (withinYear || sameYear) {
    return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
  }
  return d.toLocaleDateString("en-US", { month: "short", year: "numeric" });
};

// -------- sort --------
const sorted = [...projects].sort((a, b) => {
  if (a.data.order != null && b.data.order != null)
    return a.data.order - b.data.order;
  if (a.data.order != null) return -1;
  if (b.data.order != null) return 1;
  const sd =
    STATUS_ORDER[primaryStatus(a.data.status)] -
    STATUS_ORDER[primaryStatus(b.data.status)];
  return sd !== 0 ? sd : a.data.title.localeCompare(b.data.title);
});

// -------- postponed split --------
// A project is "postponed" when it's paused, has no ETA, and no link —
// i.e. a dream with no work-in-flight and no shipping surface.
const isPostponed = (p: Project) => {
  const statuses = normalizeStatus(p.data.status);
  return statuses.includes("paused") && !p.data.eta && !p.data.link;
};
const mainProjects = sorted.filter((p) => !isPostponed(p));
const postponedProjects = sorted.filter(isPostponed);
---

<div class="ptable">
  {
    mainProjects.map((project) => {
      const statuses = effectiveStatuses(project);
      const prime = primaryStatus(statuses);
      const internalUrl = `/projects/${project.slug}`;
      const etaText = project.data.eta ? formatEta(project.data.eta) : null;

      return (
        <div
          class="row-container"
          onclick={`window.location.href='${internalUrl}'`}
          style="cursor: pointer;"
        >
          <div class={`prow prow--${prime}`}>
            <div class="col-status">
              <div class="statuses">
                {statuses.map((s) => (
                  <span class="status-item">
                    <span class={`dot dot--${s}`} />
                    <span class="status-label">{STATUS_LABEL[s]}</span>
                  </span>
                ))}
              </div>
            </div>

            <div class="col-name">
              <div class="title-row">
                <span class="title">{project.data.title}</span>
                {project.data.version && (
                  <span class="version">{project.data.version}</span>
                )}
              </div>
              {project.data.description && (
                <span class="desc">{project.data.description}</span>
              )}
              {(project.data.effort || project.data.leverage) && (
                <div class="tags">
                  {project.data.effort && (
                    <span class={`tag tag--${project.data.effort}`}>
                      {levelLabel(project.data.effort, "effort")}
                    </span>
                  )}
                  {project.data.leverage && (
                    <span class={`tag tag--${project.data.leverage}`}>
                      {levelLabel(project.data.leverage, "leverage")}
                    </span>
                  )}
                </div>
              )}
            </div>

            <div class="col-action">
              {project.data.link ? (
                <a
                  class="btn btn--dark"
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  onclick="event.stopPropagation();"
                >
                  <span>{project.data.ctaLabel ?? "Use"}</span>
                  <span class="arrow">&rarr;</span>
                </a>
              ) : etaText ? (
                <span class="btn btn--muted">
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                  <span>{etaText}</span>
                </span>
              ) : (
                <span class="btn btn--muted">
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 18h6M10 22h4" />
                    <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2v.3h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z" />
                  </svg>
                  <span>Planning</span>
                </span>
              )}
            </div>
          </div>
        </div>
      );
    })
  }
</div>

{
  postponedProjects.length > 0 && (
    <details class="postponed">
      <summary>
        <svg
          class="chev"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
        <span>Postponed ({postponedProjects.length})</span>
      </summary>
      <div class="ptable ptable--postponed">
        {postponedProjects.map((project) => {
          const statuses = effectiveStatuses(project);
          const prime = primaryStatus(statuses);
          const internalUrl = `/projects/${project.slug}`;

          return (
            <div
              class="row-container"
              onclick={`window.location.href='${internalUrl}'`}
              style="cursor: pointer;"
            >
              <div class={`prow prow--${prime}`}>
                <div class="col-status">
                  <div class="statuses">
                    {statuses.map((s) => (
                      <span class="status-item">
                        <span class={`dot dot--${s}`} />
                        <span class="status-label">{STATUS_LABEL[s]}</span>
                      </span>
                    ))}
                  </div>
                </div>

                <div class="col-name">
                  <div class="title-row">
                    <span class="title">{project.data.title}</span>
                    {project.data.version && (
                      <span class="version">{project.data.version}</span>
                    )}
                  </div>
                  {project.data.description && (
                    <span class="desc">{project.data.description}</span>
                  )}
                  {(project.data.effort || project.data.leverage) && (
                    <div class="tags">
                      {project.data.effort && (
                        <span class={`tag tag--${project.data.effort}`}>
                          {levelLabel(project.data.effort, "effort")}
                        </span>
                      )}
                      {project.data.leverage && (
                        <span class={`tag tag--${project.data.leverage}`}>
                          {levelLabel(project.data.leverage, "leverage")}
                        </span>
                      )}
                    </div>
                  )}
                </div>

                <div class="col-action">
                  <span class="btn btn--muted">
                    <svg
                      class="icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="3 6 5 6 21 6" />
                      <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                      <path d="M10 11v6M14 11v6" />
                      <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                    </svg>
                    <span>Postponed</span>
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </details>
  )
}

<style>
  :root {
    --phi: 1.618rem;
    --phi-s: 0.618rem;
  }

  .arrow {
    display: inline-block;
    transform: rotate(-45deg);
    font-weight: 800;
    font-size: 1.1em;
    line-height: 1;
    transition: transform 0.2s ease;
    vertical-align: middle;
  }

  .ptable {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    padding: 0 var(--phi);
  }
  .ptable--postponed {
    border-top: none;
    opacity: 0.7;
  }

  .row-container {
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s ease;
    margin-left: calc(var(--phi) * -1);
    margin-right: calc(var(--phi) * -1);
  }
  .row-container:hover {
    background-color: rgba(var(--ink-rgb, 0, 0, 0), 0.03);
  }

  .prow {
    display: grid;
    grid-template-columns: 1fr 2.618fr 1.618fr;
    align-items: center;
    gap: var(--phi);
    padding: var(--phi) var(--phi);
  }

  /* ---- postponed toggle ---- */
  .postponed {
    margin-top: 1.25rem;
    text-align: center;
  }
  .postponed > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    padding: 0.25rem 0.5rem;
    font-family: "Inter", sans-serif;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-dim);
    opacity: 0.4;
    cursor: pointer;
    user-select: none;
    transition: opacity 0.2s ease;
    list-style: none;
  }
  .postponed > summary::-webkit-details-marker {
    display: none;
  }
  .postponed > summary::marker {
    content: "";
  }
  .postponed > summary:hover {
    opacity: 0.75;
  }
  .postponed .chev {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .postponed[open] .chev {
    transform: rotate(180deg);
  }

  /* ---- status ---- */
  .col-status {
    display: flex;
    flex-direction: column;
    gap: var(--phi-s);
  }
  .statuses {
    display: flex;
    flex-direction: column;
    gap: 0.382rem;
  }
  .status-item {
    display: flex;
    align-items: center;
    gap: 0.382rem;
  }
  .status-label {
    font-size: 0.618rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
  }
  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot--working-on {
    background: #4caf74;
    animation: pulse 2.4s ease-in-out infinite;
  }
  .dot--paused {
    background: #b3a99a;
  }
  .dot--planned {
    background: #cdc6ba;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  /* ---- name ---- */
  .col-name {
    display: flex;
    flex-direction: column;
    gap: var(--phi-s);
  }

  .title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.618rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--ink);
  }
  .version {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    opacity: 0.7;
    transform: translateY(-1px);
  }

  .desc {
    font-size: 0.85rem;
    color: var(--ink-dim);
    line-height: 1.618;
    max-width: 45ch;
  }

  /* ---- effort / leverage tags ---- */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.382rem;
    margin-top: 0.15rem;
  }
  .tag {
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.14em 0.55em;
    border-radius: 2px;
    border: none;
    line-height: 1.5;
    font-weight: 600;
  }
  .tag--high {
    color: #761616;
    background: #eab8b8;
  }
  .tag--medium {
    color: #6f3f08;
    background: #eece90;
  }
  .tag--low {
    color: #574808;
    background: #e3d78a;
  }

  /* ---- action ---- */
  .col-action {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-width: calc(var(--phi) * 4);
    padding: 0.618rem var(--phi);
    font-family: "Cormorant Garamond", serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    border: none;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }

  .btn--dark {
    background: var(--ink, #111);
    color: var(--bg, #fff);
  }
  .btn--dark:hover {
    opacity: 0.8;
  }

  .btn--muted {
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    color: color-mix(in srgb, var(--ink) 68%, transparent);
  }
  .btn--muted:hover {
    background: color-mix(in srgb, var(--ink) 16%, transparent);
  }

  .icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  @media (max-width: 600px) {
    .prow {
      grid-template-columns: 1fr;
      padding: var(--phi) var(--phi-s);
    }
    .btn {
      width: 100%;
    }
    .col-action {
      justify-content: flex-start;
    }
  }
</style>

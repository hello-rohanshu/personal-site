---
// ============================================================
// DUMMY DATA (temporary — UI iteration only)
// Set USE_DUMMY = false to consume real (Notion-fed) props.
// ============================================================
const USE_DUMMY = true;

type StatusValue = "working-on" | "paused" | "planned";
type Level = "high" | "medium" | "low";

interface Project {
  slug: string;
  data: {
    title: string;
    description?: string;
    status: StatusValue | StatusValue[];
    eta?: string;
    link?: string;
    role?: string;
    order?: number;
    ctaLabel?: string;
    version?: string;
    effort?: Level;
    leverage?: Level;
  };
}

const DUMMY_PROJECTS: Project[] = [
  // linked + working-on + eta → "Use" + "Update" pill
  {
    slug: "dummy-ostium",
    data: {
      title: "Ostium",
      description:
        "A minimal personal knowledge manager that lives in your menu bar.",
      status: "working-on",
      link: "https://example.com",
      eta: "2026-12-01",
      version: "v1.4.2",
      effort: "high",
      leverage: "high",
      order: 1,
    },
  },
  // linked + working-on, NO eta → "Use" only (pill punished/hidden)
  {
    slug: "dummy-beacon",
    data: {
      title: "Beacon",
      description: "A small status page for personal side projects.",
      status: "working-on",
      link: "https://example.com",
      version: "v0.2.1",
      effort: "medium",
      leverage: "medium",
      order: 2,
    },
  },
  // linked + paused → "Use" only (paused is not working-on)
  {
    slug: "dummy-ledger",
    data: {
      title: "Ledger",
      description: "Plain-text expense tracking with no cloud in the loop.",
      status: "paused",
      link: "https://example.com",
      version: "v2.0.0",
      effort: "medium",
      leverage: "low",
      ctaLabel: "Open",
      order: 3,
    },
  },
  // linked + multi-status [working-on, paused] + eta → Use + pill
  {
    slug: "dummy-driftwood",
    data: {
      title: "Driftwood",
      description: "A slow-reader for long articles you saved years ago.",
      status: ["working-on", "paused"],
      link: "https://example.com",
      eta: "2027-02-10",
      version: "v0.9.0",
      effort: "low",
      leverage: "high",
      order: 4,
    },
  },
  // no link + paused + eta → derived to "planned", shows ETA pill
  {
    slug: "dummy-quiet-hours",
    data: {
      title: "Quiet Hours",
      description:
        "A focus timer that respects your calendar and mutes itself during calls.",
      status: "paused",
      eta: "2026-11-15",
      version: "v0.3.0",
      effort: "low",
      leverage: "medium",
      order: 5,
    },
  },
  // no link + working-on, no eta → main table, "Planning" bulb
  {
    slug: "dummy-field-notes",
    data: {
      title: "Field Notes",
      description: "A pocket notebook for capture, sync, and slow review.",
      status: "working-on",
      effort: "medium",
      leverage: "high",
      order: 6,
    },
  },
  // no link + no eta → falls into "Hidden" section, labeled "Planning"
  {
    slug: "dummy-tide",
    data: {
      title: "Tide",
      description: "Sleep-aware reading companion.",
      status: "working-on",
      effort: "low",
      leverage: "low",
      order: 7,
    },
  },
  // no link + no eta + paused → "Hidden" section, labeled "Postponed"
  {
    slug: "dummy-ashfall",
    data: {
      title: "Ashfall",
      description: "An archive of every sunset I've logged.",
      status: "paused",
      effort: "low",
      leverage: "low",
      order: 8,
    },
  },
  // bare minimum: title + status only (no desc, version, tags, order)
  {
    slug: "dummy-placeholder",
    data: {
      title: "Placeholder",
      status: "planned",
    },
  },
  // long title + long description, to stress layout wrapping
  {
    slug: "dummy-long",
    data: {
      title: "A Very Long Project Name That Wraps",
      description:
        "This description is intentionally long to check whether the max-width of forty-five characters actually holds up under realistic writing, and whether the row height grows gracefully without breaking the grid columns next to it.",
      status: "working-on",
      link: "https://example.com",
      eta: "2026-10-30",
      version: "v10.11.12",
      effort: "high",
      leverage: "low",
      ctaLabel: "Try it",
      order: 9,
    },
  },
];

const propProjects = (Astro.props as { projects?: Project[] }).projects;
const projects: Project[] = USE_DUMMY ? DUMMY_PROJECTS : (propProjects ?? []);

// -------- status --------
const STATUS_ORDER: Record<string, number> = {
  "working-on": 0,
  paused: 1,
  planned: 2,
};
const STATUS_LABEL: Record<string, string> = {
  "working-on": "Working on",
  paused: "Paused",
  planned: "Planned",
};

const normalizeStatus = (s: string | string[]) => (Array.isArray(s) ? s : [s]);

// A paused project that has a date but no usable surface reads as "planned".
const effectiveStatuses = (p: Project): string[] => {
  const raw = normalizeStatus(p.data.status);
  if (raw.includes("paused") && !p.data.link && p.data.eta) {
    return raw.map((s) => (s === "paused" ? "planned" : s));
  }
  return raw;
};
const primaryStatus = (s: string | string[]) => {
  const list = normalizeStatus(s);
  return list.reduce(
    (best, cur) => (STATUS_ORDER[cur] < STATUS_ORDER[best] ? cur : best),
    list[0],
  );
};

// -------- effort / leverage --------
const levelLabel = (level: Level, kind: "effort" | "leverage") =>
  `${level.charAt(0).toUpperCase()}${level.slice(1)} ${kind}`;

// -------- humane eta --------
// Always show the exact day. Add a compact two-digit year only when the
// date falls outside the current year ("Feb 10 '27"). Keeps the pill short.
const formatEta = (raw: string): string => {
  const d = new Date(raw);
  if (isNaN(d.getTime())) return raw;
  const now = new Date();
  const md = d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
  if (d.getFullYear() === now.getFullYear()) return md;
  const yy = String(d.getFullYear()).slice(-2);
  return `${md} '${yy}`;
};

// -------- sort --------
// Bucket priority:
//   0: link + working-on + eta  → Use + Update pill (highest intent)
//   1: link + working-on        → Use, actively in progress, no date
//   2: link                     → Use, not active
//   3: eta only (no link)       → ETA pill
//   4: working-on only          → Planning bulb
//   5: rest                     → Hidden / Postponed
// Within a bucket, honor manual `order` if present, else alphabetical.
const bucketOf = (p: Project): number => {
  const statuses = effectiveStatuses(p);
  const isWorking = statuses.includes("working-on");
  if (p.data.link) {
    if (isWorking && p.data.eta) return 0;
    if (isWorking) return 1;
    return 2;
  }
  if (p.data.eta) return 3;
  if (isWorking) return 4;
  return 5;
};

const sorted = [...projects].sort((a, b) => {
  const ba = bucketOf(a);
  const bb = bucketOf(b);
  if (ba !== bb) return ba - bb;

  // Manual `order` wins within a bucket (explicit override).
  if (a.data.order != null && b.data.order != null)
    return a.data.order - b.data.order;
  if (a.data.order != null) return -1;
  if (b.data.order != null) return 1;

  // Then soonest ETA first; undated items sink to the end.
  // ISO YYYY-MM-DD strings sort correctly with plain string compare.
  if (a.data.eta && b.data.eta) return a.data.eta < b.data.eta ? -1 : 1;
  if (a.data.eta) return -1;
  if (b.data.eta) return 1;

  return a.data.title.localeCompare(b.data.title);
});

// -------- hidden split --------
// A project is "hidden" when it has no usable surface (no link) and no
// date — i.e. nothing the reader can act on or look forward to.
const isPostponed = (p: Project) => {
  return !p.data.link && !p.data.eta;
};
const mainProjects = sorted.filter((p) => !isPostponed(p));
const postponedProjects = sorted.filter(isPostponed);
---

<div class="ptable">
  {
    mainProjects.map((project) => {
      const statuses = effectiveStatuses(project);
      const prime = primaryStatus(statuses);
      const internalUrl = `/projects/${project.slug}`;
      const etaText = project.data.eta ? formatEta(project.data.eta) : null;

      return (
        <div
          class="row-container"
          onclick={`window.location.href='${internalUrl}'`}
          style="cursor: pointer;"
        >
          <div class={`prow prow--${prime}`}>
            <div class="col-status">
              <div class="statuses">
                {[prime].map((s) => (
                  <span class="status-item">
                    <span class={`status-icon status-icon--${s}`}>
                      {s === "working-on" ? (
                        <svg
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          stroke="none"
                        >
                          <polygon points="6 4 20 12 6 20" />
                        </svg>
                      ) : (
                        <svg
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          stroke="none"
                        >
                          <rect x="6" y="4" width="4" height="16" />
                          <rect x="14" y="4" width="4" height="16" />
                        </svg>
                      )}
                    </span>
                    <span class="status-label">{STATUS_LABEL[s]}</span>
                  </span>
                ))}
              </div>
            </div>

            <div class="col-name">
              <div class="title-row">
                <span class="title">{project.data.title}</span>
                {project.data.version && (
                  <span class="version">{project.data.version}</span>
                )}
              </div>
              {project.data.description && (
                <span class="desc">{project.data.description}</span>
              )}
              {(project.data.effort || project.data.leverage) && (
                <div class="tags">
                  {project.data.effort && (
                    <span class={`tag tag--${project.data.effort}`}>
                      {levelLabel(project.data.effort, "effort")}
                    </span>
                  )}
                  {project.data.leverage && (
                    <span class={`tag tag--${project.data.leverage}`}>
                      {levelLabel(project.data.leverage, "leverage")}
                    </span>
                  )}
                </div>
              )}
            </div>

            <div class="col-action">
              {project.data.link ? (
                <>
                  <a
                    class="btn btn--dark"
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="event.stopPropagation();"
                  >
                    <span>{project.data.ctaLabel ?? "Use"}</span>
                    <span class="arrow">&rarr;</span>
                  </a>
                  {/* "Update" pill: only when the project has a live surface,
                      is actively being worked on, AND has a concrete ETA.
                      No ETA → intentionally hidden (punishes vagueness). */}
                  {statuses.includes("working-on") && etaText && (
                    <span class="update-note">
                      <span>Updates</span>
                      <svg
                        class="icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                      </svg>
                      <span>{etaText}</span>
                    </span>
                  )}
                </>
              ) : etaText ? (
                <span class="btn btn--muted">
                  <span>Ships</span>
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                  <span>{etaText}</span>
                </span>
              ) : (
                <span class="btn btn--muted">
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 18h6M10 22h4" />
                    <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2v.3h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z" />
                  </svg>
                  <span>Planning</span>
                </span>
              )}
            </div>
          </div>
        </div>
      );
    })
  }
</div>

{
  postponedProjects.length > 0 && (
    <details class="postponed">
      <summary>
        <svg
          class="chev"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
        <span>Hidden</span>
      </summary>
      <div class="ptable ptable--postponed">
        {postponedProjects.map((project) => {
          const statuses = effectiveStatuses(project);
          const prime = primaryStatus(statuses);
          const internalUrl = `/projects/${project.slug}`;

          return (
            <div
              class="row-container"
              onclick={`window.location.href='${internalUrl}'`}
              style="cursor: pointer;"
            >
              <div class={`prow prow--${prime}`}>
                <div class="col-status">
                  <div class="statuses">
                    {statuses.map((s) => (
                      <span class="status-item">
                        <span class={`status-icon status-icon--${s}`}>
                          {s === "working-on" ? (
                            <svg
                              viewBox="0 0 24 24"
                              fill="currentColor"
                              stroke="none"
                            >
                              <polygon points="6 4 20 12 6 20" />
                            </svg>
                          ) : (
                            <svg
                              viewBox="0 0 24 24"
                              fill="currentColor"
                              stroke="none"
                            >
                              <rect x="6" y="4" width="4" height="16" />
                              <rect x="14" y="4" width="4" height="16" />
                            </svg>
                          )}
                        </span>
                        <span class="status-label">{STATUS_LABEL[s]}</span>
                      </span>
                    ))}
                  </div>
                </div>

                <div class="col-name">
                  <div class="title-row">
                    <span class="title">{project.data.title}</span>
                    {project.data.version && (
                      <span class="version">{project.data.version}</span>
                    )}
                  </div>
                  {project.data.description && (
                    <span class="desc">{project.data.description}</span>
                  )}
                  {(project.data.effort || project.data.leverage) && (
                    <div class="tags">
                      {project.data.effort && (
                        <span class={`tag tag--${project.data.effort}`}>
                          {levelLabel(project.data.effort, "effort")}
                        </span>
                      )}
                      {project.data.leverage && (
                        <span class={`tag tag--${project.data.leverage}`}>
                          {levelLabel(project.data.leverage, "leverage")}
                        </span>
                      )}
                    </div>
                  )}
                </div>

                <div class="col-action">
                  <span class="btn btn--muted">
                    {statuses.includes("working-on") ? (
                      <svg
                        class="icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M9 18h6M10 22h4" />
                        <path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2v.3h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z" />
                      </svg>
                    ) : (
                      <svg
                        class="icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M4 7h16" />
                        <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                        <path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12" />
                      </svg>
                    )}
                    <span>
                      {statuses.includes("working-on")
                        ? "Planning"
                        : "Postponed"}
                    </span>
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </details>
  )
}

<style>
  :root {
    --phi: 1.618rem;
    --phi-s: 0.618rem;
  }

  .arrow {
    display: inline-block;
    transform: rotate(-45deg);
    font-weight: 800;
    font-size: 1.1em;
    line-height: 1;
    transition: transform 0.2s ease;
    vertical-align: middle;
  }

  .ptable {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    padding: 0 var(--phi);
  }
  .ptable--postponed {
    border-top: none;
    text-align: left;
  }

  .ptable--postponed .row-container:last-child {
    border-bottom: none;
  }

  .row-container {
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s ease;
    margin-left: calc(var(--phi) * -1);
    margin-right: calc(var(--phi) * -1);
  }
  .row-container:hover {
    background-color: rgba(var(--ink-rgb, 0, 0, 0), 0.03);
  }

  .prow {
    display: grid;
    /* fixed action column: prevents long buttons (e.g. "Updates 🕐 Feb 10 '27")
       from widening that row's column and shifting the title column vs other rows */
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.618fr) minmax(calc(var(--phi) * 7), 1.618fr);
    align-items: center;
    gap: var(--phi);
    padding: var(--phi) var(--phi);
  }

  /* ---- postponed toggle ---- */
  .postponed {
    margin-top: 0.4rem;
    text-align: center;
    position: relative;
  }
  .postponed::after {
    content: "";
    display: block;
    margin: 0 var(--phi);
    border-bottom: 1px solid var(--border);
  }
  .postponed > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    padding: 0.25rem 0.5rem;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-dim);
    opacity: 0.55;
    cursor: pointer;
    user-select: none;
    transition: opacity 0.2s ease;
    list-style: none;
  }
  .postponed > summary::-webkit-details-marker {
    display: none;
  }
  .postponed > summary::marker {
    content: "";
  }
  .postponed > summary:hover {
    opacity: 0.85;
  }
  .postponed .chev {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
    transform: rotate(180deg);
  }
  .postponed[open] .chev {
    transform: rotate(0deg);
  }

  /* ---- status ---- */
  .col-status {
    display: flex;
    flex-direction: column;
    gap: var(--phi-s);
  }
  .statuses {
    display: flex;
    flex-direction: column;
    gap: 0.382rem;
  }
  .status-item {
    display: flex;
    align-items: center;
    gap: 0.382rem;
  }
  .status-label {
    font-size: 0.618rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-dim);
  }
  .status-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    color: var(--ink-dim);
    /* prevent layout flash before style arrives */
    contain: layout paint;
  }
  .status-icon svg {
    width: 8px;
    height: 8px;
    display: block;
    overflow: visible;
  }
  .status-icon--working-on {
    color: #4caf74;
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  /* ---- name ---- */
  .col-name {
    display: flex;
    flex-direction: column;
    gap: var(--phi-s);
  }

  .title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .title {
    font-family: "Cormorant Garamond", serif;
    font-size: 1.618rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--ink);
  }
  .version {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    opacity: 0.7;
    transform: translateY(-1px);
  }

  .desc {
    font-size: 0.85rem;
    color: var(--ink-dim);
    line-height: 1.618;
    max-width: 45ch;
  }

  /* ---- effort / leverage tags ---- */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.05rem;
    opacity: 0.9;
  }
  .tag {
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.1em 0.5em;
    border-radius: 2px;
    border: none;
    line-height: 1.5;
    font-weight: 500;
    opacity: 1;
  }
  .tag--high {
    color: #ffffff;
    background: #9e2a1e;
  }
  .tag--medium {
    color: #ffffff;
    background: #e08e1a;
  }
  .tag--low {
    color: #2f2a14;
    background: #e6e04a;
  }

  /* ---- action ---- */
  .col-action {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-width: calc(var(--phi) * 4);
    padding: 0.618rem var(--phi);
    font-family: "Cormorant Garamond", serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    border: none;
    /* keep the pill on one line no matter how long the date string is
       (e.g. "Updates 🕐 Feb 2027"); prevents tall/lopsided buttons */
    white-space: nowrap;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }

  .btn--dark {
    background: var(--ink, #111);
    color: var(--bg, #fff);
  }
  .btn--dark:hover {
    opacity: 0.8;
  }

  .btn--muted {
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    color: color-mix(in srgb, var(--ink) 68%, transparent);
  }
  .btn--muted:hover {
    background: color-mix(in srgb, var(--ink) 16%, transparent);
  }

  /* "Updates" note: plain text, not a pill. Ships/Planning stay pills
     because they'll become actions (Use) when the project launches.
     No background, no padding, muted — so it never competes with Use. */
  .update-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
